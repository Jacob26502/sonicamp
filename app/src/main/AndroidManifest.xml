<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Only used to say "sync stopped: sign in again" when the server rejects the login. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      allowBackup=false: the saved password/API key is encrypted with an Android Keystore key,
      which is never backed up, so restored ciphertext could not be decrypted anyway.
      networkSecurityConfig: allows http:// servers (common on home LANs; the UI warns) and
      user-installed CA certificates (for self-signed server certificates).
    -->
    <application
        android:name=".SubsonicApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.SubsonicPoweramp">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
